# Permit login as root
PermitRootLogin yes

# Autenticação via chave pública está habilitada
PubkeyAuthentication yes

# Permitir autenticação com senha
PasswordAuthentication yes

# Permitir autenticação interativa de teclado, se desejado
KbdInteractiveAuthentication yes

# Configurações adicionais para PAM (caso esteja usando)
UsePAM yes