# Configurações Gerais
PUID=1000                     # ID do usuário do sistema
PGID=1000                     # ID do grupo do sistema
TZ=America/Sao_Paulo          # Timezone

# Configurações do Traefik
CLOUDFLARE_EMAIL=axr6.forum@gmail.com              # Email associado à conta Cloudflare
CLOUDFLARE_API_TOKEN=9a0a8ada7e27a9f575d738d187df0d35f10f9         # Token da API do Cloudflare para DNS (recomendado)
CLOUDFLARE_API_KEY=ebf09be084711dc3b7cf977f0af928a8           # (Opcional) Chave API do Cloudflare, alternativa ao API_TOKEN
CLOUDFLARE_ZONE_ID=12460d7398c1736c1b825ea6142e98ee # (Opcional) ID da zona do Cloudflare, usado em alguns casos

# Configurações de Certificados
TRAEFIK_ACME_EMAIL=           # Email usado para registrar certificados no Let's Encrypt

# Configurações do Redis
REDIS_PASSWORD=               # (Opcional) Senha do Redis, se configurada para autenticação

# Configurações do Jellyfin
JELLYFIN_PublishedServerUrl=https://canela-stream.com.br  # URL pública do Jellyfin

# Configurações do Transmission
USER=stream   # Nome de usuário para autenticação no Transmission
PASS=stream   # Senha para autenticação no Transmission

